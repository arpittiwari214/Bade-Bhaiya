# Root environment for docker compose. Copy to .env and fill in.
# The server and client also have their own .env.example for local (non-Docker) runs.

POSTGRES_USER=badebhaiya
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=badebhaiya

# Generate each separately with: openssl rand -base64 48
# Must be at least 32 characters and must differ from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Origin the browser loads the app from. With the bundled nginx proxy the
# client calls /api on its own origin, so this is only needed if you serve the
# client from a different host than the API.
CORS_ORIGINS=http://localhost:8080

LOG_LEVEL=info
