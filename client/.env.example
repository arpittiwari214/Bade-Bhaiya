# Copy to .env.local for local overrides. Vite only exposes VITE_-prefixed vars.

# Base URL the browser uses for API calls.
# Leave as /api to use the dev proxy (vite) or the nginx proxy (production).
# Set to a full origin (e.g. https://api.example.com/api) only when the API is
# served from a different host than the app.
VITE_API_URL=/api

# Where the vite dev server proxies /api to. Not shipped to the browser.
VITE_DEV_API_TARGET=http://localhost:4000
