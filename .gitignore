# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment
#
# `.env` alone matches only a file named exactly that, so a sibling like
# render-db.env or prod.env would be committed. Anything ending in .env is
# ignored instead, since these files exist to hold secrets.
*.env
.env
.env.*
!.env.example
!*.env.example

# Databases (never commit real data)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage / test output
coverage/
.nyc_output/

# Prisma generated client
server/src/generated/
**/generated/prisma/

# Editors & OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Misc
.cache/
.turbo/
*.local
