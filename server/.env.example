# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL connection string.
DATABASE_URL="postgresql://badebhaiya:badebhaiya@localhost:5432/badebhaiya?schema=public"

# Generate each with: openssl rand -base64 48
# They must differ from each other and be at least 32 characters.
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string-32-chars"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

BCRYPT_ROUNDS=12

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

LOG_LEVEL=info

# Number of proxy hops in front of the app (0 locally, 1 behind one load balancer).
TRUST_PROXY=0
